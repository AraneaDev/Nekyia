{
  "name": "nekyia",
  "version": "1.2.0",
  "description": "Search every agent CLI session on your machine and resume the right one",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AraneaDev/Nekyia.git"
  },
  "homepage": "https://aranea-development.nl/en/tools/nekyia",
  "bugs": {
    "url": "https://github.com/AraneaDev/Nekyia/issues"
  },
  "author": "AraneaDev",
  "keywords": [
    "cli",
    "bun",
    "claude-code",
    "codex",
    "opencode",
    "copilot",
    "agent",
    "sessions",
    "search",
    "resume",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "nekyia": "bin/nekyia.mjs",
    "nek": "bin/nekyia.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun run scripts/make-fixtures.ts && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "[ -d .githooks ] && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
