{
  "schema": 1,
  "id": "codebuff",
  "name": "Codebuff / Freebuff",
  "roots": ["~/.config/manicode"],
  "format": "json-dir",
  "tier": "search",
  "jsonDir": {
    "glob": "projects/*/chats/*",
    "variant": "codebuff"
  },
  "launchers": {
    "codebuff": {
      "name": "Codebuff",
      "tier": "search",
      "brief": {
        "cmd": "codebuff",
        "args": ["--cwd", "{cwd}", "{prompt}"],
        "cwd": "{cwd}"
      }
    },
    "freebuff": {
      "name": "Freebuff",
      "tier": "resume",
      "resume": {
        "cmd": "freebuff",
        "args": ["--continue", "{id}", "--cwd", "{cwd}"],
        "cwd": "{cwd}"
      }
    }
  }
}
