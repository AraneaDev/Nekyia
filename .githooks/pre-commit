#!/usr/bin/env sh
# Lints and typechecks before a commit is written.
#
# Activated by `git config core.hooksPath .githooks`, which the package's
# prepare script runs on install. Set NEKYIA_SKIP_HOOKS=1 to bypass once.
set -eu

if [ "${NEKYIA_SKIP_HOOKS:-0}" = "1" ]; then
  echo "pre-commit: skipped (NEKYIA_SKIP_HOOKS=1)"
  exit 0
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found, skipping checks" >&2
  exit 0
fi

# Only the staged TypeScript files, so the hook stays fast on a large tree.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mjs')

if [ -n "$staged" ]; then
  echo "pre-commit: eslint"
  # shellcheck disable=SC2086
  bun x eslint --no-warn-ignored $staged
fi

echo "pre-commit: typecheck"
bun run typecheck

# The README's demo GIF is recorded from this checkout, so it is re-recorded
# whenever something it shows could have changed, and lands in the same commit.
# The recording is deterministic: an unchanged picker stages nothing new.
# It records the working tree, not the index, so a partially staged file is
# recorded as it stands on disk.
demo=$(git diff --cached --name-only --diff-filter=ACMRD -- \
  src bin test/fixtures/demo scripts/demo-gif.ts scripts/capture-svg.ts)

if [ -n "$demo" ]; then
  missing=""
  for tool in tmux rsvg-convert ffmpeg; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
  done
  if [ -n "$missing" ]; then
    echo "pre-commit: demo gif not re-recorded, missing:$missing" >&2
  else
    echo "pre-commit: demo gif"
    bun run scripts/demo-gif.ts >/dev/null
    git add docs/media/demo.gif
  fi
fi
